# ==============================================================================
# Ritucast Environment Configuration (Local Development Template)
# ==============================================================================

# Application Meta
PROJECT_NAME="Ritucast Agricultural Intelligence API"
APP_NAME="Ritucast Agricultural Intelligence API"
APP_VERSION="1.0.0-phase13"
ENVIRONMENT="development"
DEBUG=true

# Server Network Binding
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (Origins permitted to make cross-origin requests)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Data Storage Paths (Relative to repository root or absolute)
DATA_DIR="data"
PROCESSED_DIR="data/processed"
SAMPLE_DIR="data/sample"

# Operational Thresholds
DEFAULT_DANGER_LEVEL_M=8.25
MAX_WEATHER_AGE_HOURS=36.0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
