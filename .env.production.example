# ==============================================================================
# Ritucast Environment Configuration (Production Deployment Template)
# ==============================================================================

# Application Meta
PROJECT_NAME="Ritucast Agricultural Intelligence API"
APP_NAME="Ritucast Agricultural Intelligence API"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Server Network Binding (Cloud Run automatically sets $PORT, default 8080)
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (Strictly restricted to production client domains)
CORS_ORIGINS=["https://ritucast.app","https://www.ritucast.app"]

# Data Storage Paths (Pre-packaged inside container or mounted volume)
DATA_DIR="/app/data"
PROCESSED_DIR="/app/data/processed"
SAMPLE_DIR="/app/data/sample"

# Operational Thresholds (DEC-10, DEC-17)
DEFAULT_DANGER_LEVEL_M=8.25
MAX_WEATHER_AGE_HOURS=36.0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=120
